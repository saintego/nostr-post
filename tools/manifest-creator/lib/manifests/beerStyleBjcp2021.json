  "metadata": {
    "name": "Beer style (BJCP 2021)",
    "description": "Base manifest with a beer style field: the BJCP 2021 beer styles, stored as a hashtag of the style name (t tag), with the BJCP code as the option's code (not published). Extend it to add the field to posts (kind 1) or wiki entities (kind 30818). Styles from github.com/beerjson/bjcp-json, plus categories 27 and 33 from bjcp.org.",
    "tags": ["beer", "bjcp", "vocabulary"]
  }
}
