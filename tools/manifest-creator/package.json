{
  "name": "@nostr-post/manifest-creator",
  "version": "0.1.0",
  "description": "Visual manifest creator tool for nostr-post",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nostr-post/calendar": "workspace:*",
    "@nostr-post/core": "workspace:*",
    "@nostr-post/plugin-geo": "workspace:*",
    "@nostr-post/plugin-hashtag": "workspace:*",
    "@nostr-post/plugin-identifier": "workspace:*",
    "@nostr-post/plugin-list": "workspace:*",
    "@nostr-post/plugin-markdown": "workspace:*",
    "@nostr-post/plugin-media": "workspace:*",
    "@nostr-post/plugin-reference": "workspace:*",
    "@nostr-post/plugin-stars": "workspace:*",
    "@nostr-post/plugin-venue": "workspace:*",
    "@nostr-post/plugin-wiki-entity": "workspace:*",
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/react": "workspace:*",
    "@nostr-post/signer": "workspace:*",
    "@nostr-post/web": "workspace:*",
    "@nostr-post/wiki": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.5"
  }
}
