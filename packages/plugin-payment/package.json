{
  "name": "@nostr-post/plugin-payment",
  "version": "0.1.0",
  "description": "Payments for nostr-post: Lightning (LNURL-pay, NIP-57 zaps, WebLN) and on-chain Bitcoin as QR codes, in a registry of payment methods apps can extend",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugin",
    "lightning",
    "zap",
    "nip-57",
    "lnurl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*",
    "@nostr-post/plugin-qr": "workspace:*",
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/signer": "workspace:*",
    "@nostr-post/ui": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
