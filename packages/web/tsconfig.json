{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@nostr-post/core/types": ["../core/dist/types.d.ts"],
      "@nostr-post/core/manifest": ["../core/dist/manifest.d.ts"],
      "@nostr-post/core/coordinator": ["../core/dist/coordinator.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
