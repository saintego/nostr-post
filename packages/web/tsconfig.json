{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@nostr-post/core/types": ["../core/dist/types.d.ts"],
      "@nostr-post/core/manifest": ["../core/dist/manifest.d.ts"],
      "@nostr-post/core/coordinator": ["../core/dist/coordinator.d.ts"],
      "@nostr-post/core/enrichment": ["../core/dist/enrichment.d.ts"],
      "@nostr-post/plugin-geo/web": ["../plugin-geo/dist/web.d.ts"],
      "@nostr-post/plugin-hashtag/web": ["../plugin-hashtag/dist/web.d.ts"],
      "@nostr-post/plugin-identifier/web": ["../plugin-identifier/dist/web.d.ts"],
      "@nostr-post/plugin-list/web": ["../plugin-list/dist/web.d.ts"],
      "@nostr-post/plugin-markdown/web": ["../plugin-markdown/dist/web.d.ts"],
      "@nostr-post/plugin-media/web": ["../plugin-media/dist/web.d.ts"],
      "@nostr-post/plugin-stars/web": ["../plugin-stars/dist/web.d.ts"],
      "@nostr-post/plugin-venue/web": ["../plugin-venue/dist/web.d.ts"],
      "@nostr-post/plugins/registry": ["../plugins/dist/registry.d.ts"],
      "@nostr-post/plugins/types": ["../plugins/dist/types.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
