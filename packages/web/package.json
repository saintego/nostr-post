{
  "name": "@nostr-post/web",
  "version": "0.1.0",
  "description": "Universal Web Components for nostr-post: framework-independent UI for Nostr content creation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./composer": {
      "types": "./dist/composer.d.ts",
      "import": "./dist/composer.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "web-components",
    "lit",
    "custom-elements",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
