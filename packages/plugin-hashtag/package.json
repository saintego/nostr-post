{
  "name": "@nostr-post/plugin-hashtag",
  "version": "0.1.0",
  "description": "Hashtag chip input plugin for nostr-post",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
