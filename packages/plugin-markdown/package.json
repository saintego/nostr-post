{
  "name": "@nostr-post/plugin-markdown",
  "version": "0.1.0",
  "description": "Markdown editor plugin for nostr-post (raw + WYSIWYG)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugin",
    "markdown",
    "editor",
    "wysiwyg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/ui": "workspace:*",
    "lit": "^3.3.3",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "typescript": "^6.0.3"
  }
}
