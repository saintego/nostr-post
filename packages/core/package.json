{
  "name": "@nostr-post/core",
  "version": "0.1.0",
  "description": "Headless logic layer for nostr-post: manifest parsing, validation, and multi-event splitting",
  "type": "module",
  "main": "./dist/types.js",
  "types": "./dist/types.d.ts",
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator.d.ts",
      "import": "./dist/coordinator.js"
    },
    "./nip33": {
      "types": "./dist/nip33.d.ts",
      "import": "./dist/nip33.js"
    },
    "./nip78": {
      "types": "./dist/nip78.d.ts",
      "import": "./dist/nip78.js"
    },
    "./enrichment": {
      "types": "./dist/enrichment.d.ts",
      "import": "./dist/enrichment.js"
    },
    "./manifestMappings": {
      "types": "./dist/manifestMappings.d.ts",
      "import": "./dist/manifestMappings.js"
    },
    "./eventUpdates": {
      "types": "./dist/eventUpdates.d.ts",
      "import": "./dist/eventUpdates.js"
    },
    "./nip50": {
      "types": "./dist/nip50.d.ts",
      "import": "./dist/nip50.js"
    },
    "./postRoles": {
      "types": "./dist/postRoles.d.ts",
      "import": "./dist/postRoles.js"
    },
    "./enumOptions": {
      "types": "./dist/enumOptions.d.ts",
      "import": "./dist/enumOptions.js"
    },
    "./nip19": {
      "types": "./dist/nip19.d.ts",
      "import": "./dist/nip19.js"
    },
    "./noteContent": {
      "types": "./dist/noteContent.d.ts",
      "import": "./dist/noteContent.js"
    },
    "./textCompletion": {
      "types": "./dist/textCompletion.d.ts",
      "import": "./dist/textCompletion.js"
    },
    "./formJson": {
      "types": "./dist/formJson.d.ts",
      "import": "./dist/formJson.js"
    },
    "./textNormalize": {
      "types": "./dist/textNormalize.d.ts",
      "import": "./dist/textNormalize.js"
    },
    "./nip73": {
      "types": "./dist/nip73.d.ts",
      "import": "./dist/nip73.js"
    },
    "./comments": {
      "types": "./dist/comments.d.ts",
      "import": "./dist/comments.js"
    },
    "./blossom": {
      "types": "./dist/blossom.d.ts",
      "import": "./dist/blossom.js"
    },
    "./imeta": {
      "types": "./dist/imeta.d.ts",
      "import": "./dist/imeta.js"
    },
    "./geohash": {
      "types": "./dist/geohash.d.ts",
      "import": "./dist/geohash.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "test:ui": "vitest --ui --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "manifest",
    "validation",
    "event-coordination",
    "headless"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^6.0.3"
