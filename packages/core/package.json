{
  "name": "@nostr-post/core",
  "version": "0.1.0",
  "description": "Headless logic layer for nostr-post: manifest parsing, validation, and multi-event splitting",
  "type": "module",
  "main": "./dist/types.js",
  "types": "./dist/types.d.ts",
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./coordinator": {
      "types": "./dist/coordinator.d.ts",
      "import": "./dist/coordinator.js"
    },
    "./nip78": {
      "types": "./dist/nip78.d.ts",
      "import": "./dist/nip78.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist"
  },
  "keywords": ["nostr", "manifest", "validation", "event-coordination", "headless"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
