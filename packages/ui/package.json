{
  "name": "@nostr-post/ui",
  "version": "0.1.0",
  "description": "Design tokens and shared UI primitives of nostr-post: one Material 3 style visual language for every component, customizable by pages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./web/dialog": {
      "types": "./dist/web/dialog.d.ts",
      "import": "./dist/web/dialog.js"
    },
    "./web/lightbox": {
      "types": "./dist/web/lightbox.d.ts",
      "import": "./dist/web/lightbox.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./ui.css": "./dist/ui.css"
  },
  "sideEffects": [
    "./dist/web.js",
    "./dist/web/*.js",
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/writeCss.mjs",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "design-tokens",
    "material-design",
    "web-components",
    "lit",
    "theme"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
