{
  "name": "@nostr-post/plugin-stars",
  "version": "0.1.0",
  "description": "Star rating plugin for nostr-post",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugin",
    "stars",
    "rating"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/ui": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
