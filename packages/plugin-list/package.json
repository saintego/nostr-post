{
  "name": "@nostr-post/plugin-list",
  "version": "0.1.0",
  "description": "NIP-51 user lists plugin for nostr-post",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugin",
    "lists",
    "nip-51",
    "audience"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/signer": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
