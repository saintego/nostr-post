{
  "name": "@nostr-post/plugin-reference",
  "version": "0.1.0",
  "description": "Reference/link plugin for nostr-post (r tags + URL auto-extraction)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["nostr", "plugin", "reference", "url", "link"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/plugin-media": "workspace:*",
    "lit": "^3.2.1",
    "nostr-tools": "^2.7.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
