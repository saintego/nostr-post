{
  "name": "@nostr-post/wiki",
  "version": "0.1.0",
  "description": "NIP-54 wiki entity coordinator, resolver, and web components for nostr-post",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.react.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.react.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": ["nostr", "nip54", "wiki", "wikifreedia"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@djot/djot": "^0.3.0",
    "@nostr-post/core": "workspace:*",
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/signer": "workspace:*",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.0.0"
  }
}
