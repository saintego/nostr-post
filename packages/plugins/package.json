{
  "name": "@nostr-post/plugins",
  "version": "0.1.0",
  "description": "Framework-agnostic UI plugin definitions for nostr-post",
  "type": "module",
  "exports": {
    "./stars": {
      "types": "./dist/plugin-stars.d.ts",
      "import": "./dist/plugin-stars.js"
    },
    "./media": {
      "types": "./dist/plugin-media.d.ts",
      "import": "./dist/plugin-media.js"
    },
    "./markdown": {
      "types": "./dist/plugin-markdown.d.ts",
      "import": "./dist/plugin-markdown.js"
    },
    "./geo": {
      "types": "./dist/plugin-geo.d.ts",
      "import": "./dist/plugin-geo.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["nostr", "plugins", "ui", "framework-agnostic"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
