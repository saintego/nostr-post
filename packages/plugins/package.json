{
  "name": "@nostr-post/plugins",
  "version": "0.2.0",
  "description": "Plugin type definitions and registry for nostr-post",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./publish": {
      "types": "./dist/publish.d.ts",
      "import": "./dist/publish.js"
    },
    "./formJson": {
      "types": "./dist/formJson.d.ts",
      "import": "./dist/formJson.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "import": "./dist/entities.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugins",
    "ui",
    "framework-agnostic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
