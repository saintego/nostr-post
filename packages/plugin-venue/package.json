{
  "name": "@nostr-post/plugin-venue",
  "version": "0.1.0",
  "description": "Venue/place plugin for nostr-post with OSM Nominatim search and optional Google Places",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "plugin",
    "venue",
    "place",
    "osm",
    "nominatim",
    "google-places",
    "location"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*",
    "@nostr-post/plugin-geo": "workspace:*",
    "@nostr-post/plugin-list": "workspace:*",
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/signer": "workspace:*",
    "@nostr-post/wiki": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
